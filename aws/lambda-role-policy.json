{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteNotificationPrefs",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:eu-central-1:560617059298:table/SensorReadings"
    },
    {
      "Sid": "ManageAlertSubscriptions",
      "Effect": "Allow",
      "Action": [
        "sns:Subscribe",
        "sns:Unsubscribe"
      ],
      "Resource": "arn:aws:sns:eu-central-1:560617059298:AirQualityAlerts"
    }
  ]
}
